# ── Database ──────────────────────────────────────────────────────────
# Локально поднимается docker compose (порт 5435 наружу, чтобы не конфликтовать).
POSTGRES_USER=sethub
POSTGRES_PASSWORD=sethub
POSTGRES_DB=sethub
DB_PORT=5435
DATABASE_URL=postgresql://sethub:sethub@localhost:5435/sethub

# ── Auth ──────────────────────────────────────────────────────────────
# Секрет для подписи сессионного JWT (jose). Сгенерируй: openssl rand -hex 32
AUTH_SECRET=dev-secret-change-me-0000000000000000000000000000

# GitHub OAuth App (Settings → Developer settings → OAuth Apps).
# Callback URL: http://localhost:3000/api/auth/github/callback
# Если пусто — кнопки нет; без единого OAuth остаётся dev-фолбэк «войти как demo».
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Яндекс OAuth (oauth.yandex.ru → «Создать приложение», платформа «Веб-сервисы»).
# Redirect URI: {APP_URL}/api/auth/yandex/callback. Доступы: логин/имя/аватар/email.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# VK ID (id.vk.com → кабинет разработчика, тип «Web»). Секрет не нужен — PKCE.
# Redirect URI: {APP_URL}/api/auth/vk/callback (localhost для отладки разрешён).
VK_CLIENT_ID=
# Скоупы VK ID через пробел; пусто = только базовый профиль (без email).
VK_SCOPE=email

# Telegram-вход через БОТА (виджет oauth.telegram.org в РФ заблокирован, бот-флоу
# не зависит от блокировок на стороне пользователя). Бот создаётся у @BotFather.
# Вебхук (разово, с прод-сервера через мост):
#   setWebhook?url={APP_URL}/api/telegram/webhook&secret_token=$TELEGRAM_WEBHOOK_SECRET
# Прод в Bot API ходит через egress-мост (SNI-блок ТСПУ): TELEGRAM_API_BASE=
# https://tg-egress.setfork.com + TELEGRAM_API_INSECURE=1 (TLS терминится на мосту)
# + extra_hosts в docker-compose.override.yml. Локально с РФ-провайдера Bot API
# может не работать — проверять на проде.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_BASE=
TELEGRAM_API_INSECURE=

# Скрыть провайдера, не удаляя креды (через запятую: github,yandex,vk,telegram).
# RU-прод ОБЯЗАТЕЛЬНО: AUTH_DISABLED_PROVIDERS=github,telegram — на .ru только
# отечественные провайдеры (Яндекс/VK), чтобы при входе не возникала
# трансграничная передача ПДн (152-ФЗ). GitHub/Telegram — для .com.
AUTH_DISABLED_PROVIDERS=

# Гео «Seen in …» у сессий. Пусто (дефолт) = выключено, IP никуда не уходит.
# GEO_PROVIDER=ipwhois включает ipwho.is — ЗАРУБЕЖНЫЙ сервис: на RU-проде не
# включать (IP пользователя = ПДн, отправка = трансграничная передача, 152-ФЗ).
GEO_PROVIDER=

# Базовый URL приложения (для OAuth callback).
APP_URL=http://localhost:3000

# Passkeys (WebAuthn): rpID = регистрируемый домен без схемы/порта. Пусто →
# берётся хост из APP_URL/NEXT_PUBLIC_SITE_URL (для localhost — 'localhost').
# Origin проверяется по тому же доверенному origin (не по заголовкам).
WEBAUTHN_RP_ID=
# Админ-доступ: ники (handle) через запятую (напр. ADMIN_HANDLES=mikey-semy).
# НЕ оставляйте здесь `demo` в проде — demo-вход публичен (см. isAdminHandle).
ADMIN_HANDLES=

# ── Трекер ошибок (Sentry, опционально) ──────────────────────────────
# Пусто = ошибки только в структурный лог (stdout). Задан DSN → captureError
# шлёт события в Sentry напрямую (без SDK, см. shared/sentry). SENTRY_RELEASE —
# опциональный тег версии для группировки релизов.
SENTRY_DSN=
SENTRY_RELEASE=

# ── git-хранилище (TS-путь) ──────────────────────────────────────────
# GIT_DATA_DIR — том с bare-репозиториями (источник правды). Прод: смонтировать.
# GIT_DISTRIBUTED_LOCK=1 — включить pg advisory-лок поверх in-proc, если >1 инстанса
# фронта делят один GIT_DATA_DIR (иначе одновременная запись портит репо). Прод с
# Rust-ядром это не нужно — у ядра свой лок.
GIT_DATA_DIR=
GIT_DISTRIBUTED_LOCK=

# ── Квоты (мягкие лимиты от абьюза; админы без лимитов) ────────────────
# Максимум списков во владении пользователя (по умолчанию 200).
SETFORK_MAX_LISTS_PER_USER=
# Потолок AI-расхода на пользователя за календарный месяц, USD (по умолчанию 5).
SETFORK_AI_MONTHLY_USD=

# ── Email (уведомления на почту через СВОЙ SMTP) ──────────────────────
# Пусто = почта отключена (уведомления только in-app). Свой сервер, без сторонних сервисов.
# docker compose поднимает Stalwart (Rust MTA): host=mail (в сети) / localhost, port 587.
# Разовая настройка — веб-админка на :8080 (пароль админа в логах сервиса mail).
# Обычно настраивают в /admin (перекрывает эти значения); прод — 587/STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SetFork <no-reply@setfork.local>

# ── Web Push (фоновые браузерные уведомления, свои VAPID-ключи) ───────
# Пусто = push отключён. Ключи генерируются в /admin («Push-уведомления») или
# локально: `npx web-push generate-vapid-keys`. Приватный ключ — секрет.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@setfork.com

# ── Media (S3-хранилище + imgproxy) ───────────────────────────────────
# Локально: MinIO (docker compose поднимает minio + imgproxy).
# Прод (Selectel): S3_ENDPOINT=https://s3.ru-3.storage.selcloud.ru, S3_REGION=ru-3,
# свой бакет + реальные креды; CDN_URL=https://<id>.selcdn.net (CDN перед imgproxy).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sethub
S3_ACCESS_KEY=sethub
S3_SECRET_KEY=sethubsecret
S3_PATH_PREFIX=
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Публичный базовый URL imgproxy (браузер) + ключи подписи (openssl rand -hex 32).
IMGPROXY_URL=http://localhost:8081
IMGPROXY_PORT=8081
IMGPROXY_KEY=
IMGPROXY_SALT=
MEDIA_USE_IMGPROXY=true
CDN_URL=

# ── Site / SEO ────────────────────────────────────────────────────────
# Канонический origin: absolute og:image, robots host, метаданные для поиска.
NEXT_PUBLIC_SITE_URL=https://setfork.com
SETFORK_CORE_TOKEN=

# ── Rate-limit backend ────────────────────────────────────────────────
# Пусто → in-memory (1 инстанс, дефолт). Для >1 реплики app задай общий Redis
# (иначе лимиты считаются по-инстансно и легко обойти): подними профиль scale
# (docker compose --profile scale up -d) и раскомментируй:
# REDIS_URL=redis://setfork-redis:6379

# ── Бэкапы Postgres (docker-compose.dokploy.yml, сервис db-backup) ─────
# pg_dump → S3 (по умолчанию — тот же бакет/креды, что у медиа). ЕДИНСТВЕННЫЙ хост →
# бэкап обязан быть offsite. Рекомендуется ОТДЕЛЬНЫЙ бакет для бэкапов.
BACKUP_SCHEDULE=@daily              # cron или @daily/@weekly (go-cron)
BACKUP_KEEP_DAYS=14                 # ротация: старше — удаляются из S3
# BACKUP_S3_BUCKET=                 # по умолчанию = S3_BUCKET (лучше отдельный бакет)
# BACKUP_S3_DB_PREFIX=setfork/db    # префикс объектов дампа
# BACKUP_PASSPHRASE=                # если задан — дамп GPG-шифруется; СОХРАНИ его,
#                                   # без него восстановить нельзя

# АВАРИЙНЫЙ оверрайд «сайт на ремонте»: 1 = всё отвечает 503 (кроме /login и админов).
# Штатный путь — тумблер в /admin (флаг в БД). Env — когда БД лежит; из UI не снимается.
SETFORK_MAINTENANCE=
