{
  "name": "setfork-frontend",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "ui:parity": "node scripts/ui-parity.mjs",
    "ui:sizes": "node scripts/ui-sizes.mjs",
    "ui:drift": "node scripts/ui-drift.mjs",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "coverage:unit": "vitest run --coverage --coverage.reporter=json --coverage.reportsDirectory=coverage/unit --coverage.include=\"src/**/*.{ts,tsx}\"",
    "coverage:integration": "vitest run --config vitest.integration.config.ts --coverage --coverage.reporter=json --coverage.reportsDirectory=coverage/integration --coverage.include=\"src/**/*.{ts,tsx}\"",
    "coverage:check": "node scripts/coverage-merge.mjs coverage/unit/coverage-final.json coverage/integration/coverage-final.json --min 13",
    "gen:proto": "buf generate",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,css,md}\" --ignore-path .gitignore",
    "db:up": "docker compose up -d db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:bootstrap": "tsx scripts/db-bootstrap.ts",
    "db:init": "tsx scripts/db-bootstrap.ts pre && drizzle-kit push --force && tsx scripts/db-bootstrap.ts post",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "doctor": "npx react-doctor@latest",
    "itest:env": "tsx scripts/itest-env.ts",
    "audit:git-parity": "tsx --conditions=react-server scripts/git-parity-audit.ts",
    "itest:local": "tsx scripts/itest-env.ts env"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1078.0",
    "@bufbuild/protobuf": "^2.12.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-node": "^2.1.2",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.2",
    "@radix-ui/react-switch": "^1.3.2",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@tanstack/react-table": "^8.21.3",
    "@uiw/react-codemirror": "^4.25.11",
    "ai": "^6.0.218",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "emoji-mart": "^5.6.0",
    "highlight.js": "^11.11.1",
    "ioredis": "^5.11.1",
    "jose": "^6.2.3",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.16.0",
    "mcp-handler": "^1.1.0",
    "next": "^16.3.4",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.1.1",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.71.0",
    "@bufbuild/protoc-gen-es": "^2.12.1",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.2",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.0.2",
    "istanbul-lib-coverage": "^3.2.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.25",
    "prettier": "^3.7.4",
    "react-doctor": "^0.7.2",
    "server-only": "^0.0.1",
    "shadcn": "^4.16.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "sharp": "^0.35.4",
    "postcss": "^8.5.25"
  }
}
