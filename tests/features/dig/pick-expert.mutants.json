{
  "target": "src/features/dig/pick-expert.ts",
  "tests": ["tests/features/dig/pick-expert.test.ts"],
  "mutants": [
    {
      "name": "вернуть свою копию линзы (сопоставление по подстроке)",
      "from": "    roster.find((e) => !e.domains.includes('*') && e.domains.some((d) => lower.some((t) => tagMatches(t, d.toLowerCase())))) ??",
      "to": "    roster.find((e) => !e.domains.includes('*') && e.domains.some((d) => lower.some((t) => t.includes(d.toLowerCase()) || d.toLowerCase().includes(t)))) ??"
